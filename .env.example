# Login
LOGIN_EMAIL=your-login-email@example.com
LOGIN_PASSWORD=change-this-locally

# Optional iCloud SMTP for sending the 4-digit code by email.
# For iCloud Mail, use an Apple app-specific password, NOT your normal Apple ID password.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=your-icloud-address@icloud.com
SMTP_PASS=your-icloud-app-specific-password
SMTP_FROM=Device Control Center SNH <your-icloud-address@icloud.com>
